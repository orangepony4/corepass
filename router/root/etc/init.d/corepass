#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    /usr/libexec/corepass/mount-engine || return 1
    /usr/lib/corepass/runtime/corepass-router prepare || return 1
    procd_open_instance main
    procd_set_param command /usr/lib/corepass/runtime/sing-box run -c /var/run/corepass/config.json
    procd_set_param file /var/run/corepass/config.json
    procd_set_param respawn 3600 10 5
    procd_set_param term_timeout 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param env GOMEMLIMIT=64MiB GODEBUG=madvdontneed=1
    procd_set_param limits core=0 nofile="4096 4096"
    procd_close_instance
}

service_triggers() {
    procd_add_interface_trigger 'interface.*' wan /etc/init.d/corepass restart
}
