{
  "$schema":"https://schema.tauri.app/config/2",
  "productName":"Corepass Next","version":"0.3.0","identifier":"ru.corepass.next",
  "build":{"beforeDevCommand":"npm run dev","beforeBuildCommand":"npm run build","devUrl":"http://127.0.0.1:4176","frontendDist":"../dist"},
  "app":{"windows":[{"label":"main","title":"Corepass Next","width":1180,"height":900,"minWidth":1000,"minHeight":720,"theme":"Dark","center":true}],
    "security":{"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"}},
  "bundle":{"active":true,"targets":["nsis"],"icon":["icons/icon.ico"],"resources":{"resources/engine/":"engine/"},
    "windows":{"webviewInstallMode":{"type":"downloadBootstrapper"},"nsis":{"displayLanguageSelector":false,"languages":["Russian"]}}}
}
